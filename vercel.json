{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
  "outputDirectory": "dist",
  "functions": {
    "api/spreadsheet-data-handler.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/spreadsheet-data",
      "destination": "/api/spreadsheet-data-handler"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!assets/|favicon.ico|saka_logo.png|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
